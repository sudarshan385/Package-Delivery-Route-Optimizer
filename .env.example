# ==============================================================================
# Package Delivery Route Optimizer - Environment Configuration Template
# ==============================================================================
# Copy this file to .env or set these environment variables in your deployment environment.

# Database Configuration (Development)
DEV_DB_URL=jdbc:postgresql://localhost:5432/packagedeliveryrouteoptimizer
DEV_DB_USERNAME=app_user
DEV_DB_PASSWORD=your_secure_dev_db_password

# Database Configuration (Production - Required when spring.profiles.active=prod)
DB_URL=jdbc:postgresql://localhost:5432/production_route_optimizer_db
DB_USERNAME=prod_user
DB_PASSWORD=your_secure_prod_db_password

# JWT Security
# Must be at least 256 bits (32 bytes) for HMAC-SHA256
JWT_SECRET=your_secure_hmac_sha256_jwt_signing_key_min_32_bytes
JWT_EXPIRATION_MS=900000

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Server Port
SERVER_PORT=8080

# External Routing Service (OSRM)
ROUTING_OSRM_BASE_URL=http://router.project-osrm.org
